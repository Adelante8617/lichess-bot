# Lichess API token（BOT 账号）
# 获取: https://lichess.org/account/oauth/token/create
# 需要权限: bot:play, challenge:read, challenge:write
LICHESS_TOKEN=your_lichess_token_here

# OpenAI 兼容接口 key（代码里 base_url 可按需改）
OPENAI_API_KEY=your_openai_api_key_here

# Stockfish 可执行文件路径；放进 PATH 时可直接写 "stockfish"
STOCKFISH_PATH=stockfish

# Stockfish 分析深度（仅复盘阶段用；越大越慢越准）
STOCKFISH_DEPTH=14

# 等待新对局的空闲超时（秒）。超过则自动退出进程
WAIT_TIMEOUT_SEC=60
