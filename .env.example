# Lichess API token（BOT 账号）
# 获取: https://lichess.org/account/oauth/token/create
# 需要权限: bot:play, challenge:read, challenge:write
LICHESS_TOKEN=your_lichess_token_here

# ---- 下棋 / 复盘用的 LLM（任意 OpenAI 兼容接口）----
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
# 供应商私有请求参数（JSON，原样合并进请求体）。默认 {} 不传任何参数。
# 实测 micuapi 的 deepseek-v4-flash：不传参数时默认开启思考；传 {"thinking": {...}}（哪怕 type=enabled）反而关闭思考。
# 想要更强的思考可设 {"reasoning_effort": "high"}
LLM_EXTRA_BODY={}
# 单次回复的 token 上限（含思考过程）与采样温度
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3

# 每步自动召回的经验条数（0 = 关闭，只保留模型主动调用 search_experience）
AUTO_RECALL_K=3
# 落子前自检的最多轮数（0 = 关闭）
SELF_CHECK_ROUNDS=2
# 丢子守卫：程序模拟吃子交换，净亏 ≥ HANG_GUARD_MIN 分时让模型复查
HANG_GUARD=1
HANG_GUARD_MIN=2
HANG_GUARD_ROUNDS=2

# ---- RAG 用的 embedding ----
# 后端二选一：
#   api   → OpenAI 兼容接口（也可指向本地 Ollama / vLLM，如 http://localhost:11434/v1）
#   local → 进程内用 sentence-transformers 跑本地模型，完全离线（需 pip install sentence-transformers）
EMBED_BACKEND=api
EMBED_API_KEY=your_embedding_api_key_here
EMBED_BASE_URL=https://api.qingyuntop.top/v1
EMBED_MODEL=text-embedding-3-small
# backend=local 时使用；可填 HuggingFace 名称或本地目录。中文+棋谱推荐 BAAI/bge-m3
EMBED_LOCAL_MODEL=BAAI/bge-m3
# cuda / cpu，留空自动选择
EMBED_DEVICE=
# 注意：换 embedding 后旧向量不可用，改完运行 python reembed.py 重建

# Stockfish 可执行文件路径；放进 PATH 时可直接写 "stockfish"
STOCKFISH_PATH=stockfish

# Stockfish 分析深度（仅复盘阶段用；越大越慢越准）
STOCKFISH_DEPTH=14

# 等待新对局的空闲超时（秒）。超过则自动退出进程
WAIT_TIMEOUT_SEC=60

# ---- 棋盘辅助（LLM 下棋用）----
# 程序只提供按规则计算的原始事实与摆棋，不判断悬子/牵制/好坏，战术与计划由模型自己推理
# 1 = 在 prompt 中附上子力关系图（控制格、攻击/保护、直线上前后两子、王周边、兵形）
BOARD_RELATIONS=0
# 1 = 提供 play_line 分析棋盘工具，模型可自己摆多步变化核对局面
ANALYSIS_BOARD=0
# 1（默认）= 模型每步输出的战略方针 strategy 带到下一步的 prompt，形成跨步的计划；0 = 每步重新制定
PLAN_MEMORY=1
# 1 = 两阶段：先用不思考的调用定紧急情况/战略方针/≤3 个候选，再只计算这些候选（推荐与 BOARD_RELATIONS=1 一起开）
STRATEGY_STAGE=0
# 单步内最多几轮工具往返（默认：开 ANALYSIS_BOARD 时 10，否则 3）
# TOOL_ROUNDS=10

# ---- 开局快速模式 ----
# 前 N 个全回合（fullmove ≤ N）跳过落子前自检与经验自动召回，prompt 要求快速出子；
# 被将军或对方上一步吃子时自动退回完整模式。0 = 关闭
OPENING_FAST_MOVES=8
# 开局快速模式使用的思考档位（见下方 THINK_LADDER）
OPENING_EFFORT=off

# ---- 思考强度阶梯 ----
# 首次请求用第一档，每次重试（思考把 max_tokens 用光 / 走法非法）降一档，最低一档后不再降
# 档位：max / high / low → reasoning_effort=该档 + extra_body {"thinking": {"type": "enabled"}}
#       off → {"thinking": {"type": "disabled"}}；default → 不传思考参数（供应商默认）
THINK_LADDER=high,low,off
# 思考被截断、没给出答案时，带回思考末尾这么多字给下一档直接要结论；0 = 不带回
TRUNCATE_REASONING_TAIL=4000

# ---- 复杂度分流 ----
# 每步先用一次不思考的独立调用判断复杂度（开局快速模式除外），再按档位决定思考强度与 max_tokens
COMPLEXITY_CHECK=1
# 复杂度 → [起始档位, max_tokens]；重试时从起始档位沿 THINK_LADDER 往下降
COMPLEXITY_PROFILE={"simple": ["off", 4096], "medium": ["low", 8192], "complex": ["high", 16384]}
# 复杂度判断失败时使用的档
COMPLEXITY_DEFAULT=medium
# 我方子力（兵1 马象3 车5 后9）领先 ≥ 该值时不调 LLM 判断，直接用 MATERIAL_LEAD_EFFORT；0 = 关闭（默认 12 ≈ 多一个后加一个轻子）
MATERIAL_LEAD_SKIP=12
MATERIAL_LEAD_EFFORT=low
# 落子前自检的思考档位上限：决策用 high 时自检降到该档；留空 = 沿用决策档位
SELF_CHECK_EFFORT=low

# 模型思考过程：LOG_REASONING=1 把完整思考打印进日志；每步完整记录另存到 logs/games/<对局>.jsonl
LOG_REASONING=1
HANG_GUARD_POSITIONAL=2

# 背谱：赛后把评估没变差的开局记入 data/opening_book.json；对局中命中后按概率直接照走
BOOK_ENABLED=1
BOOK_PLAY_PROB=0.6
BOOK_FLOOR_CP=-100
BOOK_MAX_MOVES=15
